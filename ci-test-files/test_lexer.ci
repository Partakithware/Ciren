using stdio;
using memory;
using lexer;

public main() {
    let buf: *int = malloc(64) as *int;
    *(buf + 0) = 104;
    *(buf + 1) = 101;
    *(buf + 2) = 108;
    *(buf + 3) = 108;
    *(buf + 4) = 111;
    *(buf + 5) = 32;
    *(buf + 6) = 43;
    *(buf + 7) = 32;
    *(buf + 8) = 52;
    *(buf + 9) = 50;
    *(buf + 10) = 0;

    let l: Lexer = Lexer { src: buf, pos: 0, len: 10 };
    let lp: *Lexer = &l;
    lexer_init(lp, buf, 10);

    let tok: Token = lexer_next(lp);
    printf(c"tok1 kind=%d start=%d len=%d\n", tok.kind, tok.start, tok.length);
    tok = lexer_next(lp);
    printf(c"tok2 kind=%d start=%d len=%d\n", tok.kind, tok.start, tok.length);
    tok = lexer_next(lp);
    printf(c"tok3 kind=%d start=%d len=%d\n", tok.kind, tok.start, tok.length);
    tok = lexer_next(lp);
    printf(c"tok4 kind=%d\n", tok.kind);

    free(buf);
    return 0;
}
