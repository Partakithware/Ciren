// ─── NODE PAYLOAD UNION ───────────────────────────────────────────────────────

public union NodePayload {
    program: ProgramData,
    using_d: UsingData,
    module_d: ModuleData,
    func: FuncData,
    struct_d: StructData,
    enum_d: EnumData,
    impl_d: ImplData,
    var_d: VarData,
    block: BlockData,
    ret: RetData,
    if_d: IfData,
    while_d: WhileData,
    for_range: ForRangeData,
    for_in: ForInData,
    loop_d: LoopData,
    match_d: MatchData,
    jump: JumpData,
    defer_d: DeferData,
    expr_stmt: ExprStmtData,
    int_lit: IntLitData,
    float_lit: FloatLitData,
    str_lit: StrLitData,
    bool_lit: BoolLitData,
    ident: IdentData,
    binary: BinaryData,
    unary: UnaryData,
    assign: AssignData,
    call: CallData,
    field: FieldData,
    index: IndexData,
    cast_d: CastData,
    range: RangeData,
    struct_lit: StructLitData,
    propagate: PropagateData,
    sizeof_d: SizeofData,
    delete_d: DeleteData,
}

// ─── ASTNODE ──────────────────────────────────────────────────────────────────

public struct AstNode {
    kind: int,
    line: int,
    col: int,
    payload: NodePayload,
}

public *AstNode node_alloc(a: *Arena, kind: int, line: int, col: int) {
    let n: *AstNode = arena_alloc(a, 320) as *AstNode;
    (*n).kind = kind;
    (*n).line = line;
    (*n).col = col;
    return n;
}

// ─── HELPERS ─────────────────────────────────────────────────────────────────

public void ast_print_indent(indent: int) {
    let i: int = 0;
    while i < indent {
        printf(c"  ");
        i = i + 1;
    }
}

private cstr ast_kind_name(k: int) {
    let running: int = 1;
    let result: cstr = c"";
    if k == NK_PROGRAM { result = c"Program"; running = 0; }
    if running == 1 && k == NK_USING { result = c"Using"; running = 0; }
    if running == 1 && k == NK_MODULE { result = c"Module"; running = 0; }
    if running == 1 && k == NK_FUNC_DECL { result = c"FuncDecl"; running = 0; }
    if running == 1 && k == NK_STRUCT_DECL { result = c"StructDecl"; running = 0; }
    if running == 1 && k == NK_UNION_DECL { result = c"UnionDecl"; running = 0; }
    if running == 1 && k == NK_ENUM_DECL { result = c"EnumDecl"; running = 0; }
    if running == 1 && k == NK_INTERFACE_DECL { result = c"InterfaceDecl"; running = 0; }
    if running == 1 && k == NK_IMPL_DECL { result = c"ImplDecl"; running = 0; }
    if running == 1 && k == NK_VAR_DECL { result = c"VarDecl"; running = 0; }
    if running == 1 && k == NK_BLOCK { result = c"Block"; running = 0; }
    if running == 1 && k == NK_RETURN { result = c"Return"; running = 0; }
    if running == 1 && k == NK_IF { result = c"If"; running = 0; }
    if running == 1 && k == NK_WHILE { result = c"While"; running = 0; }
    if running == 1 && k == NK_FOR_RANGE { result = c"ForRange"; running = 0; }
    if running == 1 && k == NK_FOR_IN { result = c"ForIn"; running = 0; }
    if running == 1 && k == NK_LOOP { result = c"Loop"; running = 0; }
    if running == 1 && k == NK_MATCH { result = c"Match"; running = 0; }
    if running == 1 && k == NK_BREAK { result = c"Break"; running = 0; }
    if running == 1 && k == NK_CONTINUE { result = c"Continue"; running = 0; }
    if running == 1 && k == NK_DEFER { result = c"Defer"; running = 0; }
    if running == 1 && k == NK_EXPR_STMT { result = c"ExprStmt"; running = 0; }
    if running == 1 && k == NK_INT_LIT { result = c"IntLit"; running = 0; }
    if running == 1 && k == NK_FLOAT_LIT { result = c"FloatLit"; running = 0; }
    if running == 1 && k == NK_STRING_LIT { result = c"StrLit"; running = 0; }
    if running == 1 && k == NK_BOOL_LIT { result = c"BoolLit"; running = 0; }
    if running == 1 && k == NK_NULL_LIT { result = c"Null"; running = 0; }
    if running == 1 && k == NK_IDENT { result = c"Ident"; running = 0; }
    if running == 1 && k == NK_BINARY { result = c"Binary"; running = 0; }
    if running == 1 && k == NK_UNARY { result = c"Unary"; running = 0; }
    if running == 1 && k == NK_ASSIGN { result = c"Assign"; running = 0; }
    if running == 1 && k == NK_CALL { result = c"Call"; running = 0; }
    if running == 1 && k == NK_FIELD { result = c"Field"; running = 0; }
    if running == 1 && k == NK_INDEX { result = c"Index"; running = 0; }
    if running == 1 && k == NK_CAST { result = c"Cast"; running = 0; }
    if running == 1 && k == NK_RANGE { result = c"Range"; running = 0; }
    if running == 1 && k == NK_STRUCT_LIT { result = c"StructLit"; running = 0; }
    if running == 1 && k == NK_PROPAGATE { result = c"Propagate"; running = 0; }
    if running == 1 && k == NK_ADDRESS_OF { result = c"AddressOf"; running = 0; }
    if running == 1 && k == NK_DEREF { result = c"Deref"; running = 0; }
    if running == 1 { result = c"Node"; }
    return result;
}

public void ast_print(n: *AstNode, indent: int) {
    if n == null {
        return;
    }
    ast_print_indent(indent);
    printf(c"%s\n", ast_kind_name((*n).kind));
}

