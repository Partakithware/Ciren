// ─── ARENA ────────────────────────────────────────────────────────────────────

public struct Arena {
    base: *int,
    used: int,
    capacity: int,
}

public *Arena arena_create(cap: int) {
    let a: *Arena = malloc(12) as *Arena;
    let buf: *int = malloc(cap) as *int;
    (*a).base = buf;
    (*a).used = 0;
    (*a).capacity = cap;
    return a;
}

public *int arena_alloc(a: *Arena, size: int) {
    // align to 8 bytes
    let aligned: int = size + 7;
    aligned = aligned & -8;
    if (*a).used + aligned > (*a).capacity {
        printf(c"[ast] arena out of memory\n");
        return null;
    }
    let ptr: *int = ((*a).base + (*a).used) as *int;
    (*a).used = (*a).used + aligned;
    return ptr;
}

// ─── ASTTYPE ──────────────────────────────────────────────────────────────────

public struct AstType {
    kind: int,
    name: *int,
    inner: *AstType,
}

public *AstType type_alloc(a: *Arena, kind: int) {
    let t: *AstType = arena_alloc(a, 24) as *AstType;
    (*t).kind = kind;
    (*t).name = null;
    (*t).inner = null;
    return t;
}

public *AstType type_named(a: *Arena, name: *int) {
    let t: *AstType = type_alloc(a, TK_NAMED);
    (*t).name = name;
    return t;
}

public *AstType type_pointer(a: *Arena, inner: *AstType) {
    let t: *AstType = type_alloc(a, TK_POINTER);
    (*t).inner = inner;
    return t;
}

// ─── ASTPARAM ─────────────────────────────────────────────────────────────────

public struct AstParam {
    name: *int,
    type: *AstType,
    is_variadic: int,
}

// ─── ASTFIELD ─────────────────────────────────────────────────────────────────

public struct AstField {
    name: *int,
    type: *AstType,
}

