module input;
using stdio;

public union EventBuffer {
    bytes: [u8; 24]
}

public struct InputState {
    keys: [u8; 512],
    fd: int
}

public int is_pressed(state: *InputState, code: int) {
    // Cast and index in a single shot
    if ((state as *u8)[code] == 1) { 
        return 1; 
    }
    return 0;
}

public void update_input(state: *InputState) {
    let ev: EventBuffer;
    
    // Pass casted address directly to read
    if (read(state.fd, &ev as *void, 24) == 24) {
        // Index the address of 'ev' directly by casting to *u8
        // This avoids the 'let ptr' type mismatch entirely
        let type: int = (&ev as *u8)[16] as int;
        let code: int = (&ev as *u8)[18] as int;
        let value: int = (&ev as *u8)[20] as int;
        
        if (type == 1) { // EV_KEY
            if (value == 1) { 
                (state as *u8)[code] = 1; 
            }
            if (value == 0) { 
                (state as *u8)[code] = 0; 
            }
        }
    }
}